# ================================
# 环境配置模板
# 使用方式：复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，切勿提交真实密钥）
# ================================

# LLM配置（OpenAI 兼容接口，如 DeepSeek）
# 模型名称（需支持 function calling，DeepSeek 可用 deepseek-chat）
LLM_MODEL_ID=your-model-id

# API密钥
LLM_API_KEY=your-api-key-here

# 服务地址
LLM_BASE_URL=https://api.deepseek.com

# 超时时间（可选，默认60秒）
LLM_TIMEOUT=60

# 服务器配置
HOST=0.0.0.0
PORT=8000

# CORS配置（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 日志级别
LOG_LEVEL=INFO

# 高德地图API配置（必须是「Web服务」类型的 key）
AMAP_API_KEY=your-amap-api-key-here
